#!/usr/bin/env sh
# ectropy init hook: generated by runseal :init
set -eu
root=$(git rev-parse --show-toplevel)
cd "$root"

branch=$(git symbolic-ref --quiet --short HEAD || true)
if [ "$branch" = "main" ]; then
  printf '%s\n' "runseal pre-commit: refusing to commit directly on main" >&2
  printf '%s\n' "create a feature branch first, then commit again" >&2
  exit 1
fi

unset \
  GIT_ALTERNATE_OBJECT_DIRECTORIES \
  GIT_CONFIG \
  GIT_CONFIG_PARAMETERS \
  GIT_CONFIG_COUNT \
  GIT_OBJECT_DIRECTORY \
  GIT_DIR \
  GIT_WORK_TREE \
  GIT_IMPLICIT_WORK_TREE \
  GIT_GRAFT_FILE \
  GIT_INDEX_FILE \
  GIT_NO_REPLACE_OBJECTS \
  GIT_REPLACE_REF_BASE \
  GIT_PREFIX \
  GIT_SHALLOW_FILE \
  GIT_COMMON_DIR

runseal : deno run --allow-read "--allow-write=." --allow-env --allow-net "--allow-run=git,cargo,rustc,ectropy,deno,tea,sh,bash,pnpm,node,runseal,sed,grep" --config .runseal/deno.json --lock .runseal/deno.lock --frozen=true .runseal/wrappers/guard.ts
