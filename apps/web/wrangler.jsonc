{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "plumb",
	"compatibility_date": "2026-07-08",
	"send_metrics": false,
	"routes": [{ "pattern": "plumb.perish.uk", "custom_domain": true }],
	"assets": {
		"directory": "./dist",
		"not_found_handling": "single-page-application"
	}
}
