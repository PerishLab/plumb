{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"customConditions": ["source"],
		"allowJs": true,
		"checkJs": true,
		"strict": true,
		"noEmit": true,
		"isolatedModules": true,
		"skipLibCheck": true,
		"types": ["vitest/globals"]
	},
	"include": [
		"src/index.js",
		"tests/index.test.js",
		"tests/vitest.config.js",
		"src/vite.config.js"
	]
}
