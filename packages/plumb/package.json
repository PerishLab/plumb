{
	"name": "@perishlab/plumb",
	"description": "plumb carrier — the npm adaptor holds no export yet",
	"version": "0.0.0",
	"type": "module",
	"license": "MIT",
	"main": "dist/index.js",
	"exports": {
		".": {
			"source": "./src/index.js",
			"default": "./dist/index.js"
		}
