name: release-exact

on:
  push:
    tags:
      - v*

permissions:
  contents: read

jobs:
  release:
    uses: ./.forgejo/workflows/ship.yml
    secrets:
      publish_access: ${{ secrets.RELEASE_PUBLISH_S3_ACCESS_KEY }}
      publish_secret: ${{ secrets.RELEASE_PUBLISH_S3_SECRET_KEY }}
      publish_bucket: ${{ secrets.RELEASE_PUBLISH_S3_BUCKET }}
      publish_endpoint: ${{ secrets.RELEASE_PUBLISH_S3_ENDPOINT }}
      registry_token: ${{ secrets.RELEASE_REGISTRY_TOKEN }}
