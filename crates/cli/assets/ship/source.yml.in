      - name: Build the exact atom Plumb
        if: runner.os != 'Windows'
        shell: bash
        env:
          PLUMB_ATOM_TOKEN: ${{ github.token }}
        run: |
          set -eu
          root="$RUNNER_TEMP/plumb-atom"
          remote="${{ github.server_url }}/${{ github.repository }}.git"
          git init "$root"
          git -C "$root" remote add origin "$remote"
          fetch=(git -C "$root")
          if [ -n "$PLUMB_ATOM_TOKEN" ]; then
            basic=$(printf 'x-access-token:%s' "$PLUMB_ATOM_TOKEN" | base64 | tr -d '\n')
            fetch+=(-c "http.extraheader=AUTHORIZATION: basic $basic")
          fi
          "${fetch[@]}" fetch --no-tags --depth=1 origin "${{ github.sha }}"
          git -C "$root" checkout --detach FETCH_HEAD
          cargo build --quiet --locked --manifest-path "$root/Cargo.toml" --bin plumb
          tool=$(command -v plumb)
          cp "$root/target/debug/plumb" "$tool"
          "$tool" --version

      - name: Build the exact atom Plumb on Windows
        if: runner.os == 'Windows'
        shell: pwsh
        env:
          PLUMB_ATOM_TOKEN: ${{ github.token }}
        run: |
          $ErrorActionPreference = 'Stop'
          $root = Join-Path $env:RUNNER_TEMP 'plumb-atom'
          $remote = '${{ github.server_url }}/${{ github.repository }}.git'
          git init $root
          git -C $root remote add origin $remote
          $basic = [Convert]::ToBase64String([Text.Encoding]::UTF8.GetBytes("x-access-token:$env:PLUMB_ATOM_TOKEN"))
          git -C $root -c "http.extraheader=AUTHORIZATION: basic $basic" fetch --no-tags --depth=1 origin '${{ github.sha }}'
          git -C $root checkout --detach FETCH_HEAD
          cargo build --quiet --locked --manifest-path (Join-Path $root 'Cargo.toml') --bin plumb
          $tool = (Get-Command plumb.exe).Source
          Copy-Item (Join-Path $root 'target/debug/plumb.exe') $tool -Force
          & $tool --version
