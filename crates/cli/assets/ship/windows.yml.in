      - name: Install stable Plumb on Windows
        if: runner.os == 'Windows'
        shell: pwsh
        run: |
          $ErrorActionPreference = 'Stop'
          $manager = Join-Path $env:RUNNER_TEMP 'manage-plumb.ps1'
          Invoke-WebRequest -UseBasicParsing -Uri '{@plumb}/manage.ps1' -OutFile $manager
          & $manager install
          (Join-Path $HOME '.local/bin') | Out-File -FilePath $env:GITHUB_PATH -Append
