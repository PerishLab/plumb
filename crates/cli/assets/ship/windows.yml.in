      - name: Install stable Plumb on Windows
        if: runner.os == 'Windows'
        shell: pwsh
        run: |
          $ErrorActionPreference = 'Stop'
          $manager = Join-Path $env:RUNNER_TEMP 'manage-plumb.ps1'
          $seat = Join-Path $env:RUNNER_TEMP 'plumb-bootstrap'
          $versions = Join-Path $seat 'versions'
          $bin = Join-Path $seat 'bin'
          for ($attempt = 1; $attempt -le 5; $attempt++) {
            try {
              Invoke-WebRequest -UseBasicParsing -Uri '{@plumb}/manage.ps1' -OutFile $manager
              break
            } catch {
              if ($attempt -eq 5) { throw }
              Start-Sleep -Seconds $attempt
            }
          }
          & $manager install --install-root $versions --bin-dir $bin
          & (Join-Path $bin 'plumb.exe') depot sync
          $bin | Out-File -FilePath $env:GITHUB_PATH -Append
