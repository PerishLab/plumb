name: ship

on:
  workflow_dispatch:
    inputs:
      marker:
        description: Immutable release marker shared by every distribution medium
        required: true
        type: string
      repository:
        description: Product repository identity selected by the dispatching Plumb
        required: true
        type: string
  workflow_call:
    inputs:
      marker:
        description: Immutable release marker shared by every distribution medium
        required: false
        default: ""
        type: string
      repository:
        description: Product repository identity selected by the dispatching Plumb
        required: false
        default: ""
        type: string
      guard_contexts:
        description: JSON commit-status contexts proving the canonical source guard
        required: false
        default: ""
        type: string

permissions:
  contents: read

concurrency:
  group: ${{ inputs.repository || github.repository }}-ship-${{ inputs.marker || github.ref }}
  cancel-in-progress: false

jobs:
  resolve:
    runs-on: docker
    container:
      image: {@forge}
    outputs:
      channel: ${{ steps.plan.outputs.channel }}
      commit: ${{ steps.plan.outputs.commit }}
      version: ${{ steps.plan.outputs.version }}
      targets: ${{ steps.plan.outputs.targets }}
      project: ${{ steps.plan.outputs.project }}
    env:
      PLUMB_RELEASE_ROOT: .
      PLUMB_RELEASE_COMMIT: ${{ github.sha }}
      PLUMB_RELEASE_MARKER: ${{ inputs.marker }}
      PLUMB_RELEASE_SOURCE: ${{ github.ref }}
    steps:
      - uses: actions/checkout@v6
        with:
          fetch-depth: 0
          persist-credentials: false
          repository: ${{ inputs.repository || github.repository }}
          ref: ${{ inputs.marker || github.sha }}

{@install}
      - name: Plan this release
        id: plan
        shell: bash
        run: |
          set -eu
          if [ -n "$PLUMB_RELEASE_MARKER" ]; then
            marker=$(plumb release marker show --marker "$PLUMB_RELEASE_MARKER")
            PLUMB_RELEASE_COMMIT=$(printf '%s' "$marker" | jq -r '.commit')
            PLUMB_RELEASE_SOURCE="refs/tags/$PLUMB_RELEASE_MARKER"
            export PLUMB_RELEASE_COMMIT
            export PLUMB_RELEASE_SOURCE
          fi
          if plumb release plan --help >/dev/null 2>&1; then
            plan=$(plumb release plan)
            PLUMB_RELEASE_VERSION=$(printf '%s' "$plan" | jq -r '.version')
            PLUMB_RELEASE_CHANNEL=$(printf '%s' "$plan" | jq -r '.channel')
            PLUMB_RELEASE_PROJECT=$(printf '%s' "$plan" | jq -c '.project')
          else
            PLUMB_RELEASE_VERSION=$(plumb release reference)
            export PLUMB_RELEASE_VERSION
            PLUMB_RELEASE_CHANNEL=$(plumb release channel)
            export PLUMB_RELEASE_CHANNEL
            plumb release source
            PLUMB_RELEASE_PROJECT=$(plumb release surface | jq -c '.project')
          fi
          export PLUMB_RELEASE_VERSION
          export PLUMB_RELEASE_CHANNEL
          if [ -n "$PLUMB_RELEASE_MARKER" ]; then
            marker=$(plumb release marker show --marker "$PLUMB_RELEASE_MARKER")
            test "$(printf '%s' "$marker" | jq -r '.marker')" = "$PLUMB_RELEASE_VERSION"
            test "$(printf '%s' "$marker" | jq -r '.channel')" = "$PLUMB_RELEASE_CHANNEL"
            test "$(printf '%s' "$marker" | jq -r '.commit')" = "$PLUMB_RELEASE_COMMIT"
          fi
          {
            echo "channel=$PLUMB_RELEASE_CHANNEL"
            echo "commit=$PLUMB_RELEASE_COMMIT"
            echo "version=$PLUMB_RELEASE_VERSION"
            echo "targets=$(plumb ship binary matrix)"
            echo "project=$PLUMB_RELEASE_PROJECT"
          } >> "$GITHUB_OUTPUT"
{@binary}{@project}
