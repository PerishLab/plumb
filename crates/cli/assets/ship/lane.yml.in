name: ship

on:
  workflow_call:
    inputs:
      guard_contexts:
        description: JSON commit-status contexts proving the canonical source guard
        required: false
        default: ""
        type: string

permissions:
  contents: read

concurrency:
  group: ${{ github.repository }}-ship-${{ startsWith(github.ref, 'refs/heads/release/') && 'consensus' || github.ref }}
  cancel-in-progress: false

jobs:
  resolve:
    runs-on: docker
    container:
      image: {@forge}
    outputs:
      channel: ${{ steps.plan.outputs.channel }}
      commit: ${{ steps.plan.outputs.commit }}
      version: ${{ steps.plan.outputs.version }}
      targets: ${{ steps.plan.outputs.targets }}
      project: ${{ steps.plan.outputs.project }}
    env:
      PLUMB_RELEASE_ROOT: .
      PLUMB_RELEASE_COMMIT: ${{ github.sha }}
      PLUMB_RELEASE_SOURCE: ${{ github.ref }}
    steps:
      - uses: actions/checkout@v6
        with:
          fetch-depth: 0
          persist-credentials: false
          ref: ${{ github.sha }}

{@install}
      - name: Plan this release
        id: plan
        shell: bash
        run: |
          set -eu
          plan=$(plumb release plan)
          PLUMB_RELEASE_VERSION=$(printf '%s' "$plan" | jq -r '.version')
          export PLUMB_RELEASE_VERSION
          PLUMB_RELEASE_CHANNEL=$(printf '%s' "$plan" | jq -r '.channel')
          export PLUMB_RELEASE_CHANNEL
          {
            echo "channel=$PLUMB_RELEASE_CHANNEL"
            echo "commit=$PLUMB_RELEASE_COMMIT"
            echo "version=$PLUMB_RELEASE_VERSION"
            echo "targets=$(plumb ship binary matrix)"
            echo "project=$(printf '%s' "$plan" | jq -c '.project')"
          } >> "$GITHUB_OUTPUT"
{@binary}{@project}
