name: ship

on:
  workflow_dispatch:
    inputs:
      marker:
        description: Immutable release marker shared by every distribution medium
        required: true
        type: string
      repository:
        description: Product repository identity selected by the dispatching Plumb
        required: true
        type: string
  workflow_call:
    inputs:
      marker:
        description: Immutable release marker shared by every distribution medium
        required: false
        default: ""
        type: string
      repository:
        description: Product repository identity selected by the dispatching Plumb
        required: false
        default: ""
        type: string
permissions:
  contents: read

concurrency:
  group: ${{ inputs.repository || github.repository }}-ship-${{ inputs.marker || github.ref }}
  cancel-in-progress: true

jobs:
  resolve:
    runs-on: docker
    container:
      image: {@forge}
    outputs:
      channel: ${{ steps.plan.outputs.channel }}
      commit: ${{ steps.plan.outputs.commit }}
      version: ${{ steps.plan.outputs.version }}
      targets: ${{ steps.plan.outputs.targets }}
      binary_missing: ${{ steps.plan.outputs.binary_missing }}
      binary_reuse: ${{ steps.plan.outputs.binary_reuse }}
      project: ${{ steps.plan.outputs.project }}
    env:
      PLUMB_RELEASE_ROOT: .
      PLUMB_RELEASE_COMMIT: ${{ github.sha }}
      PLUMB_RELEASE_MARKER: ${{ inputs.marker }}
      PLUMB_RELEASE_SOURCE: ${{ github.ref }}
      PLUMB_WORKFLOW_INVENTORY_URL: ${{ secrets.WORKFLOW_INVENTORY_URL }}
    steps:
      - name: Check out the release marker
        shell: bash
        env:
          PLUMB_CHECKOUT_TOKEN: ${{ github.token }}
        run: |
          set -eu
          test -n "$PLUMB_RELEASE_MARKER"
          remote="${{ github.server_url }}/${{ inputs.repository || github.repository }}.git"
          reference="refs/tags/$PLUMB_RELEASE_MARKER"
          git init .
          git remote add origin "$remote"
          fetch=(git)
          if [ -n "$PLUMB_CHECKOUT_TOKEN" ]; then
            basic=$(printf 'x-access-token:%s' "$PLUMB_CHECKOUT_TOKEN" | base64 | tr -d '\n')
            fetch+=(-c "http.extraheader=AUTHORIZATION: basic $basic")
          fi
          "${fetch[@]}" fetch --no-tags --depth=1 origin "+$reference:$reference"
          git checkout --detach "$reference^{commit}"

{@install}
      - name: Plan this release
        id: plan
        shell: bash
        run: |
          set -eu
          if [ -n "$PLUMB_RELEASE_MARKER" ]; then
            marker=$(plumb release marker show --marker "$PLUMB_RELEASE_MARKER" --held)
            PLUMB_RELEASE_COMMIT=$(printf '%s' "$marker" | jq -r '.commit')
            PLUMB_RELEASE_SOURCE="refs/tags/$PLUMB_RELEASE_MARKER"
            export PLUMB_RELEASE_COMMIT
            export PLUMB_RELEASE_SOURCE
          fi
          if plumb release plan --help >/dev/null 2>&1; then
            plan=$(plumb release plan)
            PLUMB_RELEASE_VERSION=$(printf '%s' "$plan" | jq -r '.version')
            PLUMB_RELEASE_CHANNEL=$(printf '%s' "$plan" | jq -r '.channel')
            PLUMB_RELEASE_PROJECT=$(printf '%s' "$plan" | jq -c '.project')
          else
            PLUMB_RELEASE_VERSION=$(plumb release reference)
            export PLUMB_RELEASE_VERSION
            PLUMB_RELEASE_CHANNEL=$(plumb release channel)
            export PLUMB_RELEASE_CHANNEL
            plumb release source
            PLUMB_RELEASE_PROJECT=$(plumb release surface | jq -c '.project')
          fi
          export PLUMB_RELEASE_VERSION
          export PLUMB_RELEASE_CHANNEL
          if [ -n "$PLUMB_RELEASE_MARKER" ]; then
            test "$(printf '%s' "$marker" | jq -r '.marker')" = "$PLUMB_RELEASE_VERSION"
            test "$(printf '%s' "$marker" | jq -r '.channel')" = "$PLUMB_RELEASE_CHANNEL"
            test "$(printf '%s' "$marker" | jq -r '.commit')" = "$PLUMB_RELEASE_COMMIT"
          fi
          targets=$(plumb ship binary matrix)
          binary_reuse='[]'
          binary_missing=false
          if [ "$PLUMB_RELEASE_CHANNEL" != stable ]; then
            inventory="$RUNNER_TEMP/plumb-workflow-inventory.json"
            inventory_arg=
            if [ -n "$PLUMB_WORKFLOW_INVENTORY_URL" ] && curl -fsSL \
              --connect-timeout 3 --max-time 10 --retry 1 \
              -o "$inventory" "$PLUMB_WORKFLOW_INVENTORY_URL"; then
              inventory_arg=$inventory
            fi
            pending="$RUNNER_TEMP/plumb-binary-pending.jsonl"
            reused="$RUNNER_TEMP/plumb-binary-reused.jsonl"
            : > "$pending"
            : > "$reused"
            plumb_version=$(plumb --version | awk '{print $2}')
            depot=$(plumb depot show | sed -n '1s/^depot //p')
            projection=Cargo.toml#/workspace/package/version
            for manifest in package.json packages/*/package.json; do
              if [ -f "$manifest" ] && jq -e '.version | type == "string"' "$manifest" >/dev/null; then
                projection=$manifest#/version
                break
              fi
            done
            printf '%s' "$targets" | jq -c '.include[]' | while IFS= read -r target; do
              triple=$(printf '%s' "$target" | jq -r '.target')
              runner=$(printf '%s' "$target" | jq -r '.runner')
              archive=$(printf '%s' "$target" | jq -r '.archive')
              action="ship/binary.$triple"
              set -- plumb workflow plan \
                --world "atom=${{ github.sha }}" \
                --world "depot=$depot" \
                --world "plumb=$plumb_version" \
                --world "release=$PLUMB_RELEASE_VERSION" \
                --world "runner=$runner" \
                --world "target=$triple" \
                --identity "marker=$PLUMB_RELEASE_MARKER" \
                --project "$action=$projection"
              if [ -n "$inventory_arg" ]; then
                set -- "$@" --inventory "$inventory_arg"
              fi
              planned=$("$@" .)
              node=$(printf '%s' "$planned" | jq -c --arg action "$action" \
                '.actions[] | select(.name == $action)')
              kind=$(printf '%s' "$node" | jq -r '.reuse.type')
              if [ "$kind" = workload ]; then
                printf '%s' "$target" | jq -c \
                  --arg url "$(printf '%s' "$node" | jq -r '.reuse.source')" \
                  '. + {url:$url}' >> "$reused"
              else
                printf '%s' "$target" | jq -c \
                  --arg action "$action" \
                  --argjson keys "$(printf '%s' "$node" | jq -c '.keys')" \
                  '. + {action:$action,keys:$keys}' >> "$pending"
              fi
            done
            targets=$(jq -sc '{include:.}' "$pending")
            binary_reuse=$(jq -sc '.' "$reused")
            binary_missing=$(printf '%s' "$targets" | jq -r '.include | length > 0')
          fi
          {
            echo "channel=$PLUMB_RELEASE_CHANNEL"
            echo "commit=$PLUMB_RELEASE_COMMIT"
            echo "version=$PLUMB_RELEASE_VERSION"
            echo "targets=$targets"
            echo "binary_missing=$binary_missing"
            echo "binary_reuse=$binary_reuse"
            echo "project=$PLUMB_RELEASE_PROJECT"
          } >> "$GITHUB_OUTPUT"
{@binary}{@project}
