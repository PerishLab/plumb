
  build:
    needs: resolve
    if: needs.resolve.outputs.channel != 'stable'
    strategy:
      fail-fast: false
      matrix: ${{ fromJSON(needs.resolve.outputs.targets) }}
    runs-on: ${{ matrix.runner }}
    env:
      PLUMB_RELEASE_ROOT: .
      PLUMB_RELEASE_CHANNEL: ${{ needs.resolve.outputs.channel }}
      PLUMB_RELEASE_VERSION: ${{ needs.resolve.outputs.version }}
      PLUMB_RELEASE_COMMIT: ${{ needs.resolve.outputs.commit }}
      PLUMB_RELEASE_TARGET: ${{ matrix.target }}
      PLUMB_RELEASE_ARTIFACTS: dist/${{ needs.resolve.outputs.version }}
    steps:
      - uses: actions/checkout@v6
        with:
          persist-credentials: false
          ref: ${{ needs.resolve.outputs.commit }}

{@carry}
      - name: Add the declared Rust target
        run: rustup target add ${{ matrix.target }}

      - name: Build one declared target
        run: plumb ship binary build

      - uses: actions/upload-artifact@v3
        with:
          name: release-${{ matrix.target }}
          path: dist/${{ needs.resolve.outputs.version }}/*

  seal:
    needs: [resolve, build]
    if: >-
      always() && needs.resolve.result == 'success' &&
      (needs.resolve.outputs.channel == 'stable' || needs.build.result == 'success')
    runs-on: docker
    container:
      image: {@forge}
    outputs:
      manager_unix: ${{ steps.surface.outputs.manager_unix }}
      manager_windows: ${{ steps.surface.outputs.manager_windows }}
    env:
      DOCKER_HOST: tcp://172.17.0.1:2375
      PLUMB_RELEASE_ROOT: .
      PLUMB_RELEASE_CHANNEL: ${{ needs.resolve.outputs.channel }}
      PLUMB_RELEASE_VERSION: ${{ needs.resolve.outputs.version }}
      PLUMB_RELEASE_COMMIT: ${{ needs.resolve.outputs.commit }}
      PLUMB_RELEASE_ARTIFACTS: dist/${{ needs.resolve.outputs.version }}
      PLUMB_RELEASE_TOOLCHAIN: {@forge}
      PLUMB_RELEASE_OUTPUT: .plumb-release/capsule
      PLUMB_RELEASE_CAPSULE: .plumb-release/capsule/capsule.json
      PLUMB_PUBLISH_ACCESS: ${{ secrets.RELEASE_PUBLISH_S3_ACCESS_KEY }}
      PLUMB_PUBLISH_SECRET: ${{ secrets.RELEASE_PUBLISH_S3_SECRET_KEY }}
      PLUMB_PUBLISH_BUCKET: ${{ secrets.RELEASE_PUBLISH_S3_BUCKET }}
      PLUMB_PUBLISH_ENDPOINT: ${{ secrets.RELEASE_PUBLISH_S3_ENDPOINT }}
      PLUMB_ACTIVATE_ACCESS: ${{ secrets.RELEASE_ACTIVATE_S3_ACCESS_KEY }}
      PLUMB_ACTIVATE_SECRET: ${{ secrets.RELEASE_ACTIVATE_S3_SECRET_KEY }}
      PLUMB_ACTIVATE_BUCKET: ${{ secrets.RELEASE_ACTIVATE_S3_BUCKET }}
      PLUMB_ACTIVATE_ENDPOINT: ${{ secrets.RELEASE_ACTIVATE_S3_ENDPOINT }}
    steps:
      - uses: actions/checkout@v6
        with:
          fetch-depth: 0
          persist-credentials: false
          ref: ${{ needs.resolve.outputs.commit }}

{@install}
      - name: Fetch the derived promotion proof and its binary artifacts
        if: needs.resolve.outputs.channel == 'stable'
        env:
          PLUMB_RELEASE_PROMOTION: .plumb-release/promotion.json
        run: plumb release promote

      - uses: actions/download-artifact@v3
        if: needs.resolve.outputs.channel != 'stable'
        with:
          path: dist/${{ needs.resolve.outputs.version }}

      - name: Assemble the declared binary shape
        run: plumb ship binary assemble

      - name: Compile the exact capsule
        if: needs.resolve.outputs.channel != 'stable'
        run: plumb release compile

      - name: Compile the stable capsule
        if: needs.resolve.outputs.channel == 'stable'
        env:
          PLUMB_RELEASE_PROMOTION: .plumb-release/promotion.json
        run: plumb release compile

      - name: Publish and read back the exact release
        shell: bash
        run: |
          set -eu
          plumb ship binary publish
          plumb ship binary verify

      - name: Point the channel at what this run published
        shell: bash
        run: |
          set -eu
          plumb release activate

      - name: Activate the stable consensus
        if: needs.resolve.outputs.channel == 'stable'
        shell: bash
        run: |
          set -eu
          plumb ship binary activate
          PLUMB_RELEASE_ACTIVATED=true plumb ship binary verify

      - name: Name the generated managers
        id: surface
        shell: bash
        run: |
          set -eu
          if [ "$PLUMB_RELEASE_CHANNEL" = stable ]; then
            seat="$PLUMB_RELEASE_OUTPUT/stable.json"
          else
            seat="$PLUMB_RELEASE_OUTPUT/seal.json"
          fi
          {
            echo "manager_unix=$(jq -r '.managers.unix.url' "$seat")"
            echo "manager_windows=$(jq -r '.managers.windows.url // ""' "$seat")"
          } >> "$GITHUB_OUTPUT"

      - uses: actions/upload-artifact@v3
        with:
          name: release-capsule
          path: .plumb-release/capsule

  smoke:
    needs: [resolve, seal]
    if: needs.resolve.outputs.channel != 'stable'
    strategy:
      fail-fast: false
      matrix: ${{ fromJSON(needs.resolve.outputs.targets) }}
    runs-on: ${{ matrix.runner }}
    env:
      PLUMB_RELEASE_ROOT: .
      PLUMB_RELEASE_VERSION: ${{ needs.resolve.outputs.version }}
    steps:
      - uses: actions/checkout@v6
        with:
          persist-credentials: false
          ref: ${{ needs.resolve.outputs.commit }}

{@carry}
      - name: Smoke the generated manager
        if: runner.os != 'Windows'
        env:
          PLUMB_RELEASE_URL: ${{ needs.seal.outputs.manager_unix }}
        run: plumb ship binary smoke

      - name: Smoke the generated manager on Windows
        if: runner.os == 'Windows'
        env:
          PLUMB_RELEASE_URL: ${{ needs.seal.outputs.manager_windows }}
        run: plumb ship binary smoke
