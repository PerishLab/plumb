      - name: Install the Plumb this line is generated by
        shell: bash
        run: |
          set -eu
          held=$(curl -fsSL "{@plumb}/v1/channels/beta.json" 2>/dev/null \
            | sed -n 's/.*"releaseVersion"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p') || held=""
          case "$GITHUB_REF" in *"/$held") held="" ;; esac
          if [ -n "$held" ]; then
            seat="$RUNNER_TEMP/plumb-$held"
            curl -fsSL {@plumb}/manage.sh | sh -s -- install \
              --channel beta --version "$held" \
              --install-root "$seat/versions" --bin-dir "$seat/bin"
            printf '%s\n' "$seat/bin" >> "$GITHUB_PATH"
          else
            curl -fsSL {@plumb}/manage.sh | sh
            printf '%s\n' "$HOME/.local/bin" >> "$GITHUB_PATH"
          fi
