
  project:
    name: project (${{ matrix.medium }})
    needs: [resolve{@after}]
    strategy:
      fail-fast: false
      matrix: ${{ fromJSON(needs.resolve.outputs.project) }}
    runs-on: docker
    container:
      image: {@forge}
    env:
      DOCKER_HOST: tcp://172.17.0.1:2375
      PLUMB_RELEASE_ROOT: .
      PLUMB_RELEASE_CHANNEL: ${{ needs.resolve.outputs.channel }}
      PLUMB_RELEASE_VERSION: ${{ needs.resolve.outputs.version }}
      PLUMB_RELEASE_COMMIT: ${{ needs.resolve.outputs.commit }}
      PLUMB_RELEASE_OUTPUT: .plumb-release/capsule
      PLUMB_RELEASE_CAPSULE: .plumb-release/capsule/capsule.json
      PLUMB_RELEASE_REGISTRY_TOKEN: ${{ secrets.RELEASE_REGISTRY_TOKEN }}
      PLUMB_SITE_TOKEN: ${{ secrets.PLUMB_SITE_TOKEN }}
    steps:
      - uses: actions/checkout@v6
        if: matrix.control != 'reuse'
        with:
          fetch-depth: 0
          persist-credentials: false
          ref: ${{ needs.resolve.outputs.commit }}

{@project_install}
{@capsule}      - name: Install declared packages
        if: matrix.control != 'reuse' && matrix.medium != 'chart' && (matrix.medium != 'npm' || matrix.reuse.type == 'none')
        shell: bash
        run: |
          set -eu
          if test -f pnpm-lock.yaml; then
            corepack enable
            pnpm install --frozen-lockfile --store-dir "$RUNNER_TEMP/pnpm-store"
          fi

      - name: Project one declared medium
        if: matrix.control != 'reuse' && matrix.medium != 'npm' && matrix.medium != 'chart'
        shell: bash
        run: |
          set -eu
          plumb ship ${{ matrix.medium }} ${{ matrix.prepare }}
          plumb ship ${{ matrix.medium }} publish

      - name: Project one exact module
        if: matrix.control != 'reuse' && matrix.medium == 'npm'
        shell: bash
        env:
          PLUMB_WORKFLOW_INVENTORY_ACCESS: ${{ secrets.WORKFLOW_INVENTORY_S3_ACCESS_KEY }}
          PLUMB_WORKFLOW_INVENTORY_SECRET: ${{ secrets.WORKFLOW_INVENTORY_S3_SECRET_KEY }}
          PLUMB_WORKFLOW_INVENTORY_BUCKET: ${{ secrets.WORKFLOW_INVENTORY_S3_BUCKET }}
          PLUMB_WORKFLOW_INVENTORY_ENDPOINT: ${{ secrets.WORKFLOW_INVENTORY_S3_ENDPOINT }}
          PLUMB_WORKFLOW_INVENTORY_URL: ${{ secrets.WORKFLOW_INVENTORY_URL }}
        run: |
          set -eu
          output="$RUNNER_TEMP/plumb-module.log"
          plumb ship npm exact \
            --package '${{ matrix.package }}' \
            --reuse '${{ toJSON(matrix.reuse) }}' > "$output"
          record=$(tail -n 1 "$output")
          workload=$(printf '%s' "$record" | jq -r '.workload')
          publication=$(printf '%s' "$record" | jq -r '.publication')
          plumb workflow record '${{ matrix.action }}' \
            --keys '${{ toJSON(matrix.keys) }}' \
            --workload "$workload" \
            --publication "$publication"

      - name: Project one exact chart
        if: matrix.control != 'reuse' && matrix.medium == 'chart'
        shell: bash
        env:
          PLUMB_WORKFLOW_INVENTORY_ACCESS: ${{ secrets.WORKFLOW_INVENTORY_S3_ACCESS_KEY }}
          PLUMB_WORKFLOW_INVENTORY_SECRET: ${{ secrets.WORKFLOW_INVENTORY_S3_SECRET_KEY }}
          PLUMB_WORKFLOW_INVENTORY_BUCKET: ${{ secrets.WORKFLOW_INVENTORY_S3_BUCKET }}
          PLUMB_WORKFLOW_INVENTORY_ENDPOINT: ${{ secrets.WORKFLOW_INVENTORY_S3_ENDPOINT }}
          PLUMB_WORKFLOW_INVENTORY_URL: ${{ secrets.WORKFLOW_INVENTORY_URL }}
        run: |
          set -eu
          output="$RUNNER_TEMP/plumb-chart.log"
          plumb ship chart exact \
            --reuse '${{ toJSON(matrix.reuse) }}' > "$output"
          record=$(tail -n 1 "$output")
          workload=$(printf '%s' "$record" | jq -r '.workload')
          publication=$(printf '%s' "$record" | jq -r '.publication')
          plumb workflow record '${{ matrix.action }}' \
            --keys '${{ toJSON(matrix.keys) }}' \
            --workload "$workload" \
            --publication "$publication"
