name: guard

on:
  pull_request:
  push:
    branches:
      - main
      - release/**
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: guard-${{ github.event.pull_request.number || github.ref }}
  cancel-in-progress: true

jobs:
  guard:
    runs-on: docker
    container:
      image: {@forge}
    env:
      PLUMB_RELEASE_VERSION: ${{ startsWith(github.ref, 'refs/heads/release/') && github.ref_name || '' }}
    steps:
      - name: Checkout
        uses: actions/checkout@v6

{@steps}
